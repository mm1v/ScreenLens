<Window x:Class="ScreenLens.Next.Overlay.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ScreenLens.Next.Views"
        Title="ScreenLens Selection Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. Dimmed Background Screenshot -->
        <Image x:Name="DimmedBackgroundImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- 2. Interactive Selection Canvas -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent" Focusable="True">
            <!-- Cutout Container (Bright un-dimmed screenshot inside selection) -->
            <Border x:Name="CutoutContainer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
                <Image x:Name="BrightCutoutImage" Stretch="Fill"/>
            </Border>

            <!-- Text Selection Layer (Overlaid on top of cutout when OCR is active) -->
            <views:TextSelectionCanvas x:Name="OcrTextLayer" Visibility="Collapsed"/>

            <!-- Selection Frame (White border + Google Lens corners) -->
            <Canvas x:Name="SelectionFrameCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                <!-- Drop shadow border -->
                <Rectangle x:Name="SelectionShadowRect" Stroke="#000000" StrokeThickness="1"/>
                <!-- Main white border (2-3px) -->
                <Rectangle x:Name="SelectionRect" Stroke="#FFFFFF" StrokeThickness="2"/>

                <!-- Google Lens Corner Brackets (3.5px round white) -->
                <Path x:Name="CornerNw" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                <Path x:Name="CornerNe" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                <Path x:Name="CornerSe" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                <Path x:Name="CornerSw" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
            </Canvas>

            <!-- 8 Circular Resize Handles -->
            <Canvas x:Name="HandlesCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                <Ellipse x:Name="HandleNw" Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleN"  Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleNe" Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleE"  Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleSe" Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleS"  Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleSw" Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
                <Ellipse x:Name="HandleW"  Width="12" Height="12" Fill="#FFFFFF" Stroke="#202124" StrokeThickness="1.5"/>
            </Canvas>

            <!-- Dimension / Coordinates Badge -->
            <Border x:Name="DimensionBadge"
                    Visibility="Collapsed"
                    Background="#CC14171F"
                    BorderBrush="#00E5FF"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6,3"
                    IsHitTestVisible="False">
                <TextBlock x:Name="DimensionText" Text="0 × 0 px" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
            </Border>

            <!-- Floating Action HUD -->
            <views:FloatingHudControl x:Name="HudControl" Visibility="Collapsed"/>

            <!-- Result Card Panel (for Translation / AI card) -->
            <Border x:Name="ResultCard"
                    Visibility="Collapsed"
                    Background="#181C26"
                    BorderBrush="#00E5FF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    MaxWidth="480">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="ResultCardTitle" Text="Результат" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF5252"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CloseResultCard_Click"/>
                    </Grid>
                    <TextBox x:Name="ResultCardContent"
                             TextWrapping="Wrap"
                             IsReadOnly="True"
                             Background="#202533"
                             Foreground="#FFFFFF"
                             BorderBrush="#30384D"
                             FontSize="11"
                             MaxHeight="180"
                             VerticalScrollBarVisibility="Auto"
                             Padding="6"/>
                    <Button x:Name="BtnResultCopy"
                            Content="📋 Скопировать"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Background="#00E5FF"
                            Foreground="#000000"
                            FontWeight="Bold"
                            FontSize="11"
                            Padding="10,4"
                            Cursor="Hand"
                            Click="BtnResultCopy_Click"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
